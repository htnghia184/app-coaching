# E-Master Personal Coaching (learn.e-master.vn)
# Public Supabase configuration — dùng CHUNG project production với test.e-master.vn.
# KHÔNG bao giờ đưa service-role key vào file này hoặc vào code client.
#
# Lấy các giá trị public này từ Supabase Dashboard → Project Settings → API.

# URL project Supabase (ví dụ: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Publishable / anon key (public, an toàn cho browser). Điền 1 trong 2 biến dưới.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
